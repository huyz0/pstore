 #[must_use]
 pub fn nonce_for(epoch: Epoch, lane: LaneId) -> u64 {
-    epoch.0.wrapping_mul(0x9E37_79B9_7F4A_7C15) ^ lane.0
+    epoch.0.wrapping_mul(0x9E37_79B9_7F4A_7C15) | /* ~ changed by cargo-mutants ~ */ lane.0
 }
 
