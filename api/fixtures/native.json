{
 "description": "The native API's semantic fixtures (M220): one tenant's steps, run in order against a fresh server with an empty in-memory store, no read cache, and PSTORE_APPLIED_WRITES=5. Each step names an operationId of api/openapi.json; its response must have the status, validate against the operation's schema for it, and contain `expect` (an object holds at least the keys given, an array exactly the items given, in order). A step's `absent` lists JSON pointers its answer must not hold. A step marked `invalid` sends a request (body or query) the contract must refuse.",
 "tenant": "7",
 "steps": [
  {
   "name": "a new tenant has no indexes",
   "operation": "list_indexes",
   "status": 200,
   "expect": {
    "indexes": [],
    "next_cursor": null
   }
  },
  {
   "name": "an index is created empty",
   "operation": "create_index",
   "path": {
    "index": "fx"
   },
   "body": {
    "dims": 2,
    "distance_metric": "euclidean_squared"
   },
   "status": 200
  },
  {
   "name": "creating it again is refused",
   "operation": "create_index",
   "path": {
    "index": "fx"
   },
   "body": {
    "dims": 2
   },
   "status": 409,
   "expect": {
    "error": {
     "code": "index_exists",
     "retryable": false
    }
   }
  },
  {
   "name": "a durable write",
   "operation": "write_documents",
   "path": {
    "index": "fx"
   },
   "body": {
    "durability": "durable",
    "distance_metric": "euclidean_squared",
    "documents": [
     {
      "id": "a",
      "vector": [
       0.0,
       0.0
      ],
      "attributes": {
       "color": "red",
       "n": 3
      }
     },
     {
      "id": "b",
      "vector": [
       1.0,
       0.0
      ],
      "attributes": {
       "color": "blue",
       "n": 1
      }
     },
     {
      "id": "c",
      "vector": [
       3.0,
       0.0
      ],
      "attributes": {
       "color": "blue"
      }
     }
    ]
   },
   "status": 200,
   "expect": {
    "documents_written": 3,
    "durable": true
   }
  },
  {
   "name": "a write's metric is dot_product when absent, and must be the index's",
   "operation": "write_documents",
   "path": {
    "index": "fx"
   },
   "body": {
    "documents": [
     {
      "id": "z",
      "vector": [
       0.0,
       0.0
      ]
     }
    ]
   },
   "status": 400,
   "expect": {
    "error": {
     "code": "schema_conflict"
    }
   }
  },
  {
   "name": "an unknown write field is refused",
   "operation": "write_documents",
   "path": {
    "index": "fx"
   },
   "body": {
    "documentz": []
   },
   "status": 400,
   "expect": {
    "error": {
     "code": "bad_request",
     "retryable": false
    }
   },
   "invalid": true
  },
  {
   "name": "the tenant is folded",
   "operation": "fold_tenant",
   "status": 200
  },
  {
   "name": "the summary",
   "operation": "get_index",
   "path": {
    "index": "fx"
   },
   "status": 200,
   "expect": {
    "index": "fx",
    "documents": 3,
    "unfolded": false,
    "read_only": false,
    "schema": {
     "dims": 2,
     "distance_metric": "euclidean_squared"
    }
   }
  },
