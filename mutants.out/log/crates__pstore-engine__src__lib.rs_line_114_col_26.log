-    let jitter = (lane.0 % 8) + 1;
+    let jitter = (lane.0 / /* ~ changed by cargo-mutants ~ */ 8) + 1;
     tokio::time::sleep(std::time::Duration::from_micros(base * jitter)).await;
 }
 
